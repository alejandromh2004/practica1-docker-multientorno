# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN (.env.example)
# Copia este archivo a .env.dev o .env.prod y ajusta sus valores.
# ==============================================================================

# Entorno y Puertos
WEB_PORT=5000

# Configuración de PostgreSQL
DB_HOST=db
DB_NAME=practica_db
DB_USER=usuario_ejemplo
DB_PASSWORD=contrasena_segura_aqui
DB_PORT=5432

# Configuración de Redis (Solo requerido en Producción)
REDIS_HOST=redis
REDIS_PORT=6379